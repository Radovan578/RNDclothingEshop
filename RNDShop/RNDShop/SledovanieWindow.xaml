<Window x:Class="RND_clothing_e_shop.SledovanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sledovanie zásielky" 
        Height="350" 
        Width="500"
        WindowStartupLocation="CenterScreen" 
        Background="#FF111111">

    <Grid Margin="30">

        <TextBlock x:Name="ZiadnaZasielkaTxt" 
                   Text="Momentálne nemáte žiadnu aktívnu zásielku na sledovanie." 
                   Foreground="Gray" 
                   FontSize="16" 
                   FontWeight="Medium"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Visibility="Visible"/>

        <StackPanel x:Name="DetailZasielkyPanel" 
                    VerticalAlignment="Center" 
                    Visibility="Collapsed">

            <TextBlock Text="Sledovanie poslednej objednávky" 
                       Foreground="Gray" 
                       FontSize="15" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="CisloObjednavkyTxt" 
                       Text="Objednávka: #00000" 
                       Foreground="White" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"/>

            <Border Background="#CC1A1A1A" 
                    CornerRadius="14" 
                    Padding="20" 
                    Margin="0,20" 
                    BorderBrush="#FF333333" 
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Aktuálny stav balíka:" 
                               Foreground="Gray" 
                               FontSize="12" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="StavZasielkyTxt" 
                               Text="Spracováva sa v sklade" 
                               Foreground="#FF4A90E2" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Pre bližšie informácie očakávajte SMS alebo e-mail od kuriéra." 
                       Foreground="Gray" 
                       FontSize="12" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</Window>