<Window x:Class="RND_clothing_e_shop.ShopPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obchod"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF111111">

    <Window.Resources>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#CC1F1F1F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Image Source="Images/background.png"
               Stretch="UniformToFill"
               Opacity="2.0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <Button Content="←"
                Width="70"
                Height="70"
                FontSize="30"
                FontWeight="Bold"
                Background="#66000000"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="25"
                Cursor="Hand"
                Click="BackButton_Click"
                Panel.ZIndex="3">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="35">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="Opustiť obchod"
                Width="150"
                Height="55"
                FontSize="18"
                FontWeight="Bold"
                Background="#66000000"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="25,25,190,25"
                Cursor="Hand"
                Click="LogoutButton_Click"
                Panel.ZIndex="3">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Content="👤 Môj Profil"
                Width="150"
                Height="55"
                FontSize="16"
                FontWeight="SemiBold"
                Background="#FF262626"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="25"
                Cursor="Hand"
                Click="ProfileButton_Click"
                Panel.ZIndex="3">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" BorderBrush="#FF444444" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid Margin="40">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#CC1A1A1A"
                    CornerRadius="20"
                    Padding="20"
                    Margin="0,0,20,0">

                <StackPanel>

                    <TextBlock Text="Kategórie"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <Button Content="Všetko"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="AllCategory_Click"/>

                    <Button Content="Tričká"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="TrickaCategory_Click"/>

                    <Button Content="Mikiny"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="MikinyCategory_Click"/>

                    <Button Content="Nohavice"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="NohaviceCategory_Click"/>

                    <Button Content="Bundy"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="BundyCategory_Click"/>

                    <Button Content="Topánky"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="TopankyCategory_Click"/>

                    <Button Content="Doplnky"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="DoplnkyCategory_Click"/>

                    <Border Height="30"/>

                    <Button Content="Prejsť do košíka"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="White"
                            Foreground="Black"
                            Click="CartButton_Click"/>

                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#CC1A1A1A"
                    CornerRadius="20"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock Text="Obchod"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <Border Width="320"
                                Height="45"
                                CornerRadius="22"
                                Background="#AA2A2A2A"
                                BorderBrush="#FF444444"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🔍"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#DDFFFFFF"/>

                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="Gray"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"
                                         CaretBrush="White"
                                         Text="Hľadať..."
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>

                            </Grid>
                        </Border>

                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,20,0,0">

                        <WrapPanel x:Name="ProductsPanel"
                                   Margin="20"/>

                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <Border x:Name="ProfilePopup" 
                Visibility="Collapsed" 
                Background="#FF1A1A1A" 
                BorderBrush="#FF444444" 
                BorderThickness="1" 
                CornerRadius="18" 
                Width="260" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,90,25,0"
                Panel.ZIndex="4">
            <Border.Padding>20</Border.Padding>
            <StackPanel>
                <TextBlock Text="Môj Profil" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Používateľ: " Foreground="#A0A0A0" FontSize="15"/>
                    <TextBlock x:Name="ProfileNameText" Text="Ján Mrkvička" FontWeight="SemiBold" Foreground="White" FontSize="15"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="Zostatok: " Foreground="#A0A0A0" FontSize="15"/>
                    <TextBlock Text="84,50 €" FontWeight="Bold" Foreground="#FF4CAF50" FontSize="15"/>
                </StackPanel>

                <Separator Background="#555555" Margin="0,10"/>

                <Button Content="📦 Sledovať objednávku" Click="TrackOrder_Click" Background="Transparent" Foreground="#FF4A90E2" FontSize="14" HorizontalAlignment="Left" Margin="0,6" Cursor="Hand"/>
                <Button Content="📜 História nákupov" Click="TrackOrder_Click" Background="Transparent" Foreground="#FF4A90E2" FontSize="14" HorizontalAlignment="Left" Margin="0,6" Cursor="Hand"/>

                <Separator Background="#555555" Margin="0,10"/>

                <Button Content="Zavrieť" Click="CloseProfile_Click" Style="{StaticResource RoundedButtonStyle}" Background="#FF333333" Foreground="White" Height="35" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>