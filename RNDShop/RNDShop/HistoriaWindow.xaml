<Window x:Class="RND_clothing_e_shop.HistoriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="História nákupov" 
        Height="500" 
        Width="650"
        WindowStartupLocation="CenterScreen" 
        Background="#FF111111">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Moja história nákupov" 
                   Foreground="White" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoriaList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#CC1A1A1A" 
                                CornerRadius="14" 
                                Padding="15" 
                                Margin="0,0,0,12" 
                                BorderBrush="#FF333333" 
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IdObjednavky, StringFormat='Objednávka {0}'}" 
                                               Foreground="White" 
                                               FontSize="16" 
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Datum, StringFormat='Dátum nákupu: {0:dd.MM.yyyy HH:mm}'}" 
                                               Foreground="Gray" 
                                               FontSize="13" 
                                               Margin="0,4,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stav: " Foreground="Gray" FontSize="13"/>
                                        <TextBlock Text="{Binding StavZasielky}" 
                                                   Foreground="#FF4A90E2" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding CelkovaCena, StringFormat='{}{0:N2} €'}" 
                                           Foreground="#FF4CAF50" 
                                           FontWeight="Bold" 
                                           FontSize="18" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>